{
  "name": "eleventy-base-blog",
  "version": "5.0.2",
  "description": "A starter repository for a blog web site using the Eleventy static site generator.",
  "scripts": {
    "build": "npm run clean && npm run sass && ELEVENTY_ENV=production eleventy",
    "build:ci": "node scripts/optimize-media.mjs --check && npm run build && node scripts/optimize-media.mjs",
    "clean": "rm -rf dev docs",
    "sass": "sass --style=compressed src/_includes/css/index.scss src/_includes/css/index.css",
    "start": "node scripts/start.js",
    "watch:eleventy": "ELEVENTY_ENV=development eleventy --serve",
    "watch:sass": "npm run sass -- --watch"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/11ty/eleventy-base-blog.git"
  },
  "author": {
    "name": "Zach Leatherman",
    "email": "zachleatherman@gmail.com",
    "url": "https://zachleat.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/11ty/eleventy-base-blog/issues"
  },
  "homepage": "/",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-navigation": "^0.3.5",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@quasibit/eleventy-plugin-sitemap": "^2.2.0",
    "luxon": "^3.4.2",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^8.6.7",
    "npm-run-all": "^4.1.5",
    "sass": "^1.32.2",
    "sharp": "^0.35.3"
  }
}
