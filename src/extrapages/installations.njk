{% include "components/header.njk" %}


<div class="fullcontainer small-caption">
  <div class="grid">
    <div class="grid-col grid-col--1">
    </div>
    <div class="grid-col grid-col--2">
    </div>
    {% for installation in collections.installations2025 %}
      <div class="grid-item imagediv">
            <a href="{{ installation.url }}">
              <figure><img class="imagecard" src="{{ installation.data.heroImage or installation.data.image }}"/><figcaption>{{ installation.data.title }}</figcaption></figure>
            </a>
      </div>
    {% endfor %}
  </div>
  <div class="bigcontainer">
    <p>Photos courtesy of <a href="https://www.instagram.com/cherrita.thao/" target="_blank">Cherrita Thao</a> and <a href="https://www.instagram.com/gary.shaw.foto/" target="_blank">Gary Shaw</a>.</p>
  </div>
</div>
</br>

<script>
window.addEventListener('load', function() {
  var colc = new Colcade('.grid', {
    columns: '.grid-col',
    items: '.grid-item'
  });
});
</script>
