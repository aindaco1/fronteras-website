---
layout: layouts/base.njk
title: Film Selections
description: Our 2023 film selections.
navlogo: emojianim
backgroundcolor: F5F5F5
permalink: /films-2023/
useColcade: true
eleventyNavigation:
  key: Films2023
  parent: "2023"
  order: 4
  title: Films
---

{% include "components/header.njk" %}

<br><br>
<div class="fullcontainer small-caption">
  <div class="grid">
    <div class="grid-col grid-col--1">
    </div>
    <div class="grid-col grid-col--2">
    </div>
    <div class="grid-col grid-col--3">
    </div>
    <div class="grid-col grid-col--4">
    </div>
    {% for film in collections.films2023 %}
      <div class="grid-item imagediv">
            <a href="{{ film.url }}">
              <figure><img class="imagecard" src="{{ film.data.image }}" alt="{{ film.data.title }}"{% if loop.first %} fetchpriority="high"{% elif loop.index > 4 %} loading="lazy" decoding="async"{% endif %}/><figcaption>{{ film.data.title }}</figcaption></figure>
            </a>
      </div>
    {% endfor %}
  </div>
</div>
</br>

<script>
window.addEventListener('load', function() {
  var colc = new Colcade('.grid', {
    columns: '.grid-col',
    items: '.grid-item'
  });
});
</script>
