---
layout: layouts/base.njk
---

{% include "components/header.njk" %}
</br>
<div class="bigcontainer">
  <div class="full-width-post">
    <div class="hero-with-laurel">
      {% if laurelImage %}
      <img src="{{ laurelImage }}" alt="Award" class="laurel-overlay">
      {% endif %}
      <img src="{{ image }}" alt="{{ title }} film still" class="post-hero installation-hero">
    </div>
    {% if youtubeId %}
    </br>
    <div class="embed-container">
      <iframe src="https://www.youtube.com/embed/{{ youtubeId }}" title="{{ title }}" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
    </div>
    {% endif %}
    </br>
    {% if artistStatement %}<p><i>"{{ artistStatement | nl2br | safe }}"</i></p>{% endif %}
    {% if authors %}
    {% for author in authors %}
    {% if author.bio %}
    </br>
    <p>{{ author.bio | safe }}</p>
    {% endif %}
    {% endfor %}
    {% endif %}
  </div>
  </br></br>
</div>
