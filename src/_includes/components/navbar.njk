{% from "components/icon.njk" import icon %}
<header>
      <div class="navbar" id="mynavbar">
        <div class="logodiv">
          {% set logo = navlogo | navlogoToValue %}
          {% if logo =="fronteras" %}
            <h2 class="home"><a href="{{ '/' | url }}">Fronteras</a></h1>
          {% elif logo =="emoji" %}
            <h2 class="home"><a href="{{ '/' | url }}">🤬🤬🤬</a></h1>
          {% elif logo =="emojiknight" %}
            <h2 class="home"><a href="{{ '/' | url }}">🗡🗡🗡</a></h1>
          {% elif logo =="emojiskull" %}
            <h2 class="home"><a href="{{ '/' | url }}">💀💀💀</a></h1>
          {% elif logo =="customs" %}
            <h2 class="home"><a href="{{ '/' | url }}">🛃🛃🛃</a></h1>
          {% elif logo =="cash" %}
            <h2 class="home"><a href="{{ '/' | url }}">💰💰💰</a></h1>
          {% elif logo =="emojianim" %}
            <h2 class="home"><a href="{{ '/' | url }}">🎥🎥🎥</a></h1>
          {% elif logo =="emojipencils" %}
            <h2 class="home"><a href="{{ '/' | url }}">✒️✒️✒️</a></h1>
          {% elif logo =="handwave" %}
            <h2 class="home"><a href="{{ '/' | url }}">👋👋👋</a></h1>
          {% elif logo =="wave" %}
            <h2 class="home"><a href="{{ '/' | url }}">🌊🌊🌊</a></h1>
          {% elif logo =="question" %}
            <h2 class="home"><a href="{{ '/' | url }}">❔❔❔</a></h1>
          {% elif logo =="installation" %}
            <h2 class="home"><a href="{{ '/' | url }}">📺📺📺</a></h1>
          {% elif logo =="news" %}
            <h2 class="home"><a href="{{ '/' | url }}">🗞️🗞️🗞️</a></h1>
          {% elif logo =="emojipeach" %}
            <h2 class="home"><a href="{{ '/' | url }}">🍑🍑🍑</a></h1>
          {% elif logo =="thanks" %}
            <h2 class="home"><a href="{{ '/' | url }}">🙏🙏🙏</a></h1>
          {% elif logo =="trophy" %}
            <h2 class="home"><a href="{{ '/' | url }}">🏆🏆🏆</a></h1>
          {% elif logo =="boat" %}
            <h2 class="home"><a href="{{ '/' | url }}">⛵⛵⛵</a></h1>
          {% elif logo =="tower" %}
            <h2 class="home"><a href="{{ '/' | url }}">🗼🗼🗼</a></h1>
          {% elif logo =="clouds" %}
            <h2 class="home"><a href="{{ '/' | url }}">☁️☁️☁️</a></h1>
          {% elif logo =="flashlight" %}
            <h2 class="home"><a href="{{ '/' | url }}">🔦🔦🔦</a></h1>
          {% elif logo =="loudspeaker" %}
            <h2 class="home"><a href="{{ '/' | url }}">📢📢📢</a></h1>
          {% elif logo =="door" %}
            <h2 class="home"><a href="{{ '/' | url }}">🚪🚪🚪</a></h1>
          {% elif logo =="truck" %}
            <h2 class="home"><a href="{{ '/' | url }}">🚚🚚🚚</a></h1>
          {% else %}
           <h2 class="home"><a href="{{ '/' | url }}">Fronteras</a></h1>
          {% endif %}
        </div>

    <div class="navstuff" id="navcollapse">

      {# Main nav (not parent or children of 2023) #}
      {%- for entry in collections.all | eleventyNavigation %}
        {%- if not entry.parent and entry.key != "2023" %}
          <a class="nav-item{% if entry.url == page.url %} nav-item-active{% endif %}" href="{{ entry.url | url }}">
            {{ entry.title }}
          </a>
        {%- endif %}
      {%- endfor %}

      {# 2023 Dropdown -- parent item (not a real link, just a label/button) #}
      <div class="dropdown">
        <a href="#" class="dropbtn">2023</a>
        <div class="dropdown-content">
          {%- for entry in collections.all | eleventyNavigation("2023") %}
            <a class="nav-item{% if entry.url == page.url %} nav-item-active{% endif %}" href="{{ entry.url | url }}">
              {{ entry.title }}
            </a>
          {%- endfor %}
        </div>
      </div>

      {# Other fixed links #}
      <a class="nav-item" href="https://shop.dustwave.xyz/#t-shirt-2" target="_blank" rel="noopener">shop</a>
      <a class="nav-item" href="https://www.instagram.com/waveofdust/" target="_blank" rel="noopener" aria-label="Dust Wave on Instagram">
        <sub>{{ icon("instagram", "nav-icon") }}</sub>
      </a>
      <a class="nav-item" href="https://www.youtube.com/@dustwavecollective" target="_blank" rel="noopener" aria-label="Dust Wave on YouTube">
        <sub>{{ icon("youtube", "nav-icon") }}</sub>
      </a>
    </div>
    <button type="button" class="icon" data-nav-toggle aria-controls="navcollapse" aria-expanded="false" aria-label="Toggle navigation">
      {{ icon("bars", "menu-icon") }}
    </button>
  </div>
</header>
